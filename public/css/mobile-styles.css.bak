/*will apply to anything 1000px or less. this catches ipads, horizontal phones, and vertical phones)*/
@media screen and (max-width: 1000px) {

    /*
     * SAFARI FALLBACK: Older Safari versions (pre-iOS 17.4) don't support
     * @starting-style, transition-behavior: allow-discrete, or calc-size().
     * Without these, drawer panels can get stuck at height: 0 even when
     * .openDrawer is applied, making panel content invisible while the
     * backdrop blur still renders.
     *
     * This rule ensures panels get a real height immediately when opened.
     * The !important overrides the height: 0 from .drawer-content default.
     */
    #left-nav-panel.openDrawer,
    #right-nav-panel.openDrawer,
    #floatingPrompt.openDrawer,
    #cfgConfig.openDrawer,
    #logprobsViewer.openDrawer,
    #movingDivs > div.openDrawer {
        height: calc(100vh - 45px) !important;
        height: calc(100dvh - 45px) !important;
    }

    #UI-Theme-Block,
    #UI-Customization,
    #power-user-options-block,
    #ContextSettings,
    #InstructSettingsColumn,
    #InstructSequencesColumn {
        flex-basis: 100%;
    }

    #rm_button_panel_pin_div,
    #lm_button_panel_pin_div {
        display: none;
    }

    #rm_button_characters {
        font-size: var(--topBarIconSize);
    }

    #CharListButtonAndHotSwaps {
        align-items: center;
    }

    #send_form.compact #leftSendForm,
    #send_form.compact #rightSendForm {
        flex-wrap: nowrap;
        width: unset;
    }

    #sheldWidthToggleBlock {
        display: none;
    }

    #bg_menu_content,
    #bg_custom_content {
        grid-template-columns: repeat(var(--bg-thumb-columns, 3), 1fr);
    }

    .bg_list {
        width: unset;
    }

    .bg_button {
        font-size: 15px;
    }

    #Backgrounds .bg_example .BGSampleTitle {
        opacity: 1;
        bottom: 0px;
    }

    .bg_example:hover .jg-menu,
    .bg_example:focus-within .jg-menu {
        display: none;
    }

    .bg_example.mobile-menu-open .jg-menu {
        display: flex;
        z-index: 4;
    }

    .bg_example.mobile-menu-open .mobile-only-menu-toggle {
        opacity: 0;
        pointer-events: none;
    }

    .bg_example .mobile-only-menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        top: 5px;
        right: 5px;
        width: 30px;
        height: 30px;
        background-color: rgba(0, 0, 0, 0.4);
        color: white;
        border-radius: 6px;
        z-index: 3;
        cursor: pointer;
        backdrop-filter: blur(2px);
    }

    .bg_example .jg-button {
        width: 30px;
        height: 30px;
    }

    #background_fitting {
        max-width: 6em;
    }

    #Backgrounds.drawer-content.openDrawer.bg-drawer-layout {
        width: 100dvw;
        max-width: 100dvw;
    }

    #bg_tabs .bg_tabs_list .bg_tab_button {
        min-width: 6em;
    }

    #add_background_button_top>span,
    #auto_background>span {
        display: none;
    }

    #extensions_settings,
    #extensions_settings2 {
        width: 100% !important;
        min-width: 100% !important;
    }

    body:not(.waifuMode) .zoomed_avatar {
        min-width: 100px;
        min-height: 100px;
        position: absolute;
        padding: 0;
        filter: drop-shadow(2px 2px 2px #51515199);
        z-index: 30;
        overflow: hidden;
        right: 0;
        width: fit-content;
        max-height: calc(60vh - 60px);
        max-height: calc(60dvh - 60px);
        max-width: 90vw;
        max-width: 90dvw;
        left: 50%;
        top: 50%;
        transform: translateX(-50%) translateY(-50%);
        align-items: center;
        justify-content: center;
        height: fit-content;
        width: 100%;
    }

    .zoomed_avatar .dragClose {
        display: unset;
    }

    /* .world_entry_thin_controls, */
    #persona-management-block,
    #character_popup .flex-container {
        flex-direction: column;
    }

    #WIMultiSelector {
        align-self: normal;
    }

    .WIEntryContentAndMemo {
        flex-flow: column;
    }

    .WIEntryContentAndMemo .world_entry_thin_controls {
        width: 100%;
    }

    /* === World Info / Lorebook: prevent horizontal overflow on mobile === */
    #WorldInfo,
    #world_popup,
    #world_popup_entries_list {
        max-width: 100%;
        overflow-x: hidden;
    }

    .WIEntryContentAndMemo,
    .world_entry_form_control.world_entry_form_horizontal {
        flex-wrap: wrap !important;
    }

    .WIEntryContentAndMemo > *,
    .world_entry_form_control.world_entry_form_horizontal > * {
        min-width: 0;
        max-width: 100%;
    }

    .world_entry .select2-container,
    .world_entry textarea {
        max-width: 100%;
        box-sizing: border-box;
    }

    .world_entry_form_control.world_entry_form_horizontal {
        /* flex-direction: column; */
        align-items: flex-start;
        row-gap: 0.5rem;
    }

    .world_entry_form_control.world_entry_form_horizontal .world_popup_expander {
        display: none;
    }

    .world_entry .inline-drawer-toggle {
        padding-bottom: 5px;
    }

    #worldInfoScanningCheckboxes {
        flex-flow: row;
        flex-wrap: wrap;
    }

    body {
        touch-action: none;
        overflow: hidden;
        position: fixed;
    }

    .world_entry_form_control {
        /* width: 100%; */
    }

    .drawer-content {
        min-width: unset;
        width: 100dvw;
        max-height: calc(100vh - 45px);
        max-height: calc(100dvh - 45px);
        position: fixed;
        left: 0;
        top: var(--topBarBlockSize);
        border: 1px solid var(--SmartThemeBorderColor);
        /* Safari fix: force hardware acceleration and ensure panels render
           above the topbar even when the topbar is a scrollable container */
        z-index: 9999 !important;
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
        /* Ensure panel is visually distinct even if blur fails */
        background-color: var(--SmartThemeBlurTintColor);
    }

    /* Add a little breathing room below the fixed top settings strip on
       mobile so its drawers do not visually crowd the bar. */
    #top-settings-holder .drawer-content {
        top: calc(var(--topBarBlockSize) + 6px);
        max-height: calc(100vh - var(--topBarBlockSize) - var(--bottomFormBlockSize) - 6px);
        max-height: calc(100dvh - var(--topBarBlockSize) - var(--bottomFormBlockSize) - 6px);
    }

    .drawer-content .floating_panel_maximize,
    .drawer-content .inline-drawer-maximize {
        display: none;
    }

    #select_chat_popup {
        align-items: start;
        height: min-content;
        align-content: start;
        max-width: unset;
    }

    #wiActivationSettings,
    #wiTopBlock {
        flex-direction: column;
    }

    #top-settings-holder,
    #top-bar {
        position: fixed;
        width: 100vw;
        width: 100dvw;
    }

    /* Let the top tab strip scroll horizontally on small screens instead of
       compressing icons when the UI font size grows. */
    #top-settings-holder {
        display: grid !important;
        grid-auto-flow: column;
        grid-auto-columns: max-content;
        align-items: center;
        justify-content: flex-start !important;
        column-gap: 6px;
        overflow-x: auto;
        overflow-y: hidden;
        touch-action: auto;
        -ms-touch-action: auto;
        /* -webkit-overflow-scrolling: touch;  REMOVED — causes Safari to clip
           position:fixed children (drawer panels) to this container's bounds,
           making panel content invisible. See mobile panel fix notes. */
        scrollbar-width: none;
        padding: 0 8px;
        box-sizing: border-box;
        overscroll-behavior-x: contain;
        white-space: nowrap;
        margin-bottom: 10px;
    }

    #top-settings-holder::-webkit-scrollbar {
        display: none;
    }

    #top-settings-holder > .drawer {
        display: flex !important;
        align-items: center;
        justify-content: flex-start;
        width: max-content !important;
        min-width: max-content !important;
        max-width: none !important;
        flex: 0 0 auto !important;
    }

    #top-settings-holder .drawer-toggle {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: auto !important;
        min-width: max-content;
        flex: 0 0 auto !important;
    }

    #top-settings-holder .drawer-icon {
        flex: 0 0 auto;
    }

    #top-settings-holder .drawer-content,
    #top-settings-holder .scrollableInner {
        touch-action: pan-y;
        -ms-touch-action: pan-y;
        -webkit-overflow-scrolling: touch;
    }

    #PersonaManagement.openDrawer {
        max-height: calc(100vh - var(--topBarBlockSize) - var(--bottomFormBlockSize) - 12px);
        max-height: calc(100dvh - var(--topBarBlockSize) - var(--bottomFormBlockSize) - 12px);
        padding-bottom: calc(var(--bottomFormBlockSize) + env(safe-area-inset-bottom, 0px) + 16px);
        box-sizing: border-box;
        overflow-y: auto !important;
    }

    /* Keep the persona management view pinned to the visible drawer width.
       The top icon strip can scroll horizontally, but the persona panel
       itself should wrap and shrink instead of inheriting sideways overflow. */
    #right-nav-panel,
    #right-nav-panel .scrollableInner,
    #rm_ch_create_block,
    #persona-management-block,
    .persona_management_left_column,
    .persona_management_right_column,
    .persona_management_current_persona,
    #persona_controls,
    #persona_controls .persona_controls_buttons_block,
    .persona_management_description_position_container,
    #persona_depth_position_settings,
    #persona_connections_buttons {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #right-nav-panel,
    #right-nav-panel .scrollableInner,
    #persona-management-block,
    .persona_management_left_column,
    .persona_management_right_column,
    .persona_management_current_persona {
        overflow-x: hidden !important;
    }

    #right-nav-panel.openDrawer {
        display: flex !important;
        flex-direction: column !important;
        position: fixed !important;
        top: var(--topBarBlockSize) !important;
        left: 0 !important;
        right: 0 !important;
        width: 100dvw !important;
        min-width: unset !important;
        max-width: 100dvw !important;
        height: calc(100dvh - 45px) !important;
        min-height: unset !important;
        max-height: calc(100dvh - 45px) !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        box-sizing: border-box !important;
        z-index: 99999 !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    #right-nav-panel .scrollableInner {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        overflow-x: hidden !important;
    }

    #rm_ch_create_block,
    #form_create {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        overflow-x: hidden !important;
    }

    #avatar-and-name-block {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        flex-wrap: wrap !important;
    }

    #name_div {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #name_div input,
    #name_div .extension_token_counter {
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #avatar_div {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        flex-wrap: nowrap !important;
    }

    #avatar_div .avatar {
        flex: 0 0 auto !important;
    }

    #avatar_controls {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        flex-wrap: wrap !important;
    }

    #avatar_controls .form_create_bottom_buttons_block {
        flex-wrap: wrap !important;
        min-width: 0 !important;
    }

    #avatar_controls .form_create_bottom_buttons_block .menu_button,
    #avatar_controls .form_create_bottom_buttons_block label.menu_button {
        flex: 0 0 auto !important;
    }

    #descriptionWrapper,
    #firstMessageWrapper {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #form_create textarea {
        white-space: pre-wrap !important;
        overflow-wrap: break-word;
        word-break: break-word;
        overflow-x: hidden !important;
    }

    #rm_ch_create_block #spoiler_free_desc {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #rm_ch_create_block #spoiler_free_desc .inline-drawer-content {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        overflow-x: hidden !important;
    }

    #rm_ch_create_block #creator_notes_spoiler,
    #rm_ch_create_block #creator_notes_spoiler *,
    #rm_ch_create_block #description_textarea,
    #rm_ch_create_block #firstmessage_textarea {
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #rm_ch_create_block #creator_notes_spoiler img,
    #rm_ch_create_block #creator_notes_spoiler video,
    #rm_ch_create_block #creator_notes_spoiler canvas,
    #rm_ch_create_block #creator_notes_spoiler table,
    #rm_ch_create_block #creator_notes_spoiler pre,
    #rm_ch_create_block #creator_notes_spoiler blockquote {
        max-width: 100% !important;
        box-sizing: border-box !important;
        height: auto;
    }

    #rm_ch_create_block #creator_notes_spoiler {
        overflow-wrap: break-word !important;
        word-break: break-word !important;
        white-space: normal !important;
    }

    #persona-management-block {
        width: 100% !important;
        align-items: stretch;
    }

    .persona_management_left_column,
    .persona_management_right_column {
        flex: 1 1 100% !important;
        width: 100% !important;
    }

    #persona_controls {
        width: 100%;
        align-items: center;
        justify-content: space-between;
        overflow: hidden;
    }

    #persona_controls .persona_name {
        flex: 1 1 180px;
        min-width: 0;
        max-width: 100%;
    }

    #persona_controls .persona_controls_buttons_block {
        flex: 0 1 auto;
        justify-content: flex-end;
    }

    #persona_description,
    #persona_description_position,
    #persona-management-block select,
    #persona-management-block textarea,
    #persona-management-block input,
    #persona_depth_position_settings > .flex1 {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #persona_description {
        width: 100% !important;
        overflow-x: hidden !important;
    }

    .persona_management_global_settings .checkbox_label {
        align-items: flex-start;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .persona_management_global_settings .checkbox_label input {
        flex: 0 0 auto;
    }

    .persona_management_global_settings .checkbox_label span {
        flex: 1 1 auto;
        min-width: 0;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    body.ios-safari #top-settings-holder {
        display: flex !important;
        justify-content: center !important;
        overflow-x: visible !important;
        overflow-y: visible !important;
        touch-action: auto !important;
        -ms-touch-action: auto !important;
        padding-left: 0;
        padding-right: 0;
        white-space: normal;
    }

    body.ios-safari #top-settings-holder > .drawer {
        justify-content: center;
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        flex: 1 1 0 !important;
    }

    #bg1,
    #bg_custom {
        height: 100vh !important;
        height: 100dvh !important;
        width: 100vw !important;
        width: 100dvw !important;
        background-position: center;

    }


    #sheld,
    #character_popup,
    .drawer-content {
        width: 100dvw !important;
        margin: 0 auto;
        max-width: 100dvw;
        left: 0 !important;
        resize: none !important;
        top: var(--topBarBlockSize);
    }

    .wi-settings {
        flex-direction: column;
        gap: 5px !important;
    }

    #WIMultiSelector {
        width: 100%;
        min-width: 0;
    }

    #world_info + .select2-container {
        width: 100% !important;
        min-width: 0;
    }

    #WIMultiSelector .select2-container .select2-selection--multiple {
        min-height: 42px !important;
        max-height: 30dvh;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        padding: 6px 8px !important;
        display: flex !important;
        align-items: flex-start !important;
    }

    #WIMultiSelector .select2-container .select2-selection__rendered {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 6px !important;
        width: 100%;
        padding: 0 !important;
        white-space: normal !important;
    }

    #WIMultiSelector .select2-container .select2-selection__choice,
    #WIMultiSelector .select2-container .select2-search--inline {
        width: 100%;
        max-width: 100%;
        margin: 0 !important;
        box-sizing: border-box;
    }

    #WIMultiSelector .select2-container .select2-selection__choice__display {
        white-space: normal;
        word-break: break-word;
    }

    #WIMultiSelector .select2-container .select2-search--inline textarea.select2-search__field {
        width: 100% !important;
        min-height: 24px !important;
        height: 24px !important;
        margin: 0 !important;
        padding: 0 !important;
        line-height: 24px !important;
    }

    #user-settings-block [name="userSettingsRowOne"],
    #user-settings-block [name="UserSettingsRowTwo"] {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        justify-content: flex-start !important;
        gap: 8px !important;
        min-width: 0 !important;
    }

    #user-settings-block #UI-language-block,
    #user-settings-block #version_display,
    #user-settings-block #settingsSearch,
    #user-settings-block #account_controls {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #user-settings-block #account_controls {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 6px !important;
    }

    #user-settings-block #account_controls .menu_button_icon {
        width: auto !important;
        min-width: 0 !important;
        flex: 1 1 calc(50% - 6px) !important;
        justify-content: center !important;
    }

    #user-settings-block #account_controls .menu_button_icon span {
        white-space: normal !important;
        text-align: center;
    }

    #user-settings-block #settingsSearch {
        flex: 0 0 auto !important;
    }

    #user-settings-block {
        overflow-x: hidden !important;
    }

    #user-settings-block-content {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        justify-content: flex-start !important;
        gap: 10px !important;
        min-width: 0 !important;
        overflow-x: hidden !important;
    }

    #user-settings-block-content > .flex-container,
    #user-settings-block-content > div {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        flex-basis: auto !important;
        box-sizing: border-box !important;
    }

    #user-settings-block-content .spaceEvenly {
        justify-content: flex-start !important;
    }

    #user-settings-block-content .flex-container.flexnowrap,
    #user-settings-block-content .flex-container.flexNoWrap {
        flex-wrap: wrap !important;
        min-width: 0 !important;
    }

    #user-settings-block .flex-container,
    #user-settings-block .inline-drawer,
    #user-settings-block .inline-drawer-content,
    #user-settings-block .wide100p {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #user-settings-block-content select,
    #user-settings-block-content input,
    #user-settings-block-content textarea {
        max-width: 100% !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }

    #user-settings-block .widthNatural,
    #user-settings-block select.widthNatural,
    #user-settings-block input.widthNatural,
    #user-settings-block textarea.widthNatural {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
    }

    #moonlit-theme-buttons-hint,
    #moonlit-theme-buttons-hint.info-block {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        white-space: normal !important;
        overflow-wrap: anywhere;
        word-break: break-word;
        box-sizing: border-box;
    }

    #moonlit-theme-buttons-hint small,
    #moonlit-theme-buttons-hint b,
    #moonlit-theme-buttons-hint a,
    #moonlit-theme-buttons-hint span {
        white-space: inherit !important;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    #AdvancedFormatting {
        overflow-x: hidden !important;
    }

    #AdvancedFormatting > .flex-container,
    #AdvancedFormatting .spaceEvenly {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #AdvancedFormatting > .flex-container:first-child,
    #AdvancedFormatting .spaceEvenly,
    #AdvancedFormatting #ContextSettings,
    #AdvancedFormatting #InstructSettingsColumn,
    #AdvancedFormatting #SystemPromptColumn,
    #AdvancedFormatting #InstructSequencesColumn {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        justify-content: flex-start !important;
        gap: 8px !important;
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        flex-basis: auto !important;
        box-sizing: border-box !important;
    }

    #AdvancedFormatting .flex-container.flexnowrap,
    #AdvancedFormatting .flex-container.flexNoWrap,
    #AdvancedFormatting .justifySpaceBetween {
        flex-wrap: wrap !important;
        min-width: 0 !important;
    }

    #AdvancedFormatting select,
    #AdvancedFormatting input,
    #AdvancedFormatting textarea,
    #AdvancedFormatting .text_pole,
    #AdvancedFormatting .wide100p,
    #AdvancedFormatting .widthNatural,
    #AdvancedFormatting .flex1 {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    #AdvancedFormatting .menu_button_icon,
    #AdvancedFormatting .menu_button {
        max-width: 100% !important;
    }

    #advanced-formatting-cc-notice,
    #advanced-formatting-cc-notice span {
        white-space: normal !important;
        overflow-wrap: anywhere;
        word-break: break-word;
        max-width: 100% !important;
    }

    .WIEntryTitleAndStatus,
    .WIEntryHeaderControls {
        width: 100%;
    }

    #WIEntryHeaderTitlesPC {
        display: none;
    }

    .WIEntryHeaderTitleMobile {
        display: block !important;
    }

    #character_popup,
    #world_popup {
        overflow-y: auto;
    }

    #character_popup,
    #send_form {
        border: 1px solid var(--SmartThemeBorderColor);
        backdrop-filter: blur(calc(var(--SmartThemeBlurStrength) * 2));
        max-width: 100dvw;
    }

    #chat {
        border-left: 1px solid var(--SmartThemeBorderColor);
        border-right: 1px solid var(--SmartThemeBorderColor);
        border-bottom: 1px solid var(--SmartThemeBorderColor);
        align-items: start;
        align-content: start;
        overflow-y: auto;
        overflow-x: hidden
    }

    .mes_buttons {
        font-size: calc(var(--mainFontSize)*1.2);
    }

    .drag-grabber,
    .pull-tab {
        display: none !important;

    }

    #groupCurrentMemberPopoutButton,
    #summaryExtensionPopoutButton {
        display: none;
    }

    #right-nav-panel,
    #left-nav-panel,
    #floatingPrompt,
    #cfgConfig,
    #logprobsViewer,
    #movingDivs>div {
        /* 100vh are fallback units for browsers that don't support dvh */
        height: calc(100vh - 45px);
        height: calc(100dvh - 45px);
        min-width: 100dvw !important;
        width: 100dvw !important;
        max-width: 100dvw !important;
        overflow-y: hidden;
        border-left: 1px solid var(--SmartThemeBorderColor);
        border-right: 1px solid var(--SmartThemeBorderColor);
        border-bottom: 1px solid var(--SmartThemeBorderColor);
        border-radius: 0 0 20px 20px;
        top: var(--topBarBlockSize) !important;
        left: 0 !important;
        backdrop-filter: blur(calc(var(--SmartThemeBlurStrength) * 2));

        /* Modern browsers: animate from height 0 */
        @starting-style {
            height: 0;
        }
    }

    /* Fallback for browsers that don't support @starting-style (older Safari):
       ensure open panels get proper height immediately */
    @supports not (@starting-style) {
        #left-nav-panel.openDrawer,
        #right-nav-panel.openDrawer,
        #floatingPrompt.openDrawer,
        #cfgConfig.openDrawer,
        #logprobsViewer.openDrawer,
        #movingDivs>div.openDrawer {
            height: calc(100vh - 45px);
            height: calc(100dvh - 45px);
        }
    }

    #left-nav-panel:not(.openDrawer),
    #right-nav-panel:not(.openDrawer) {
        height: 0;
    }

    /*
    #right-nav-panel {
        padding-right: 15px;
    }
    */

    #floatingPrompt,
    #cfgConfig,
    #logprobsViewer,
    #movingDivs>div {
        height: min-content;
    }

    #right-nav-panel h4 {
        margin: 5px auto;
    }

    #result_info {
        font-size: calc(var(--mainFontSize) - .1rem);
    }

    /*     .avatar_div {
        margin-top: 5px;
    } */

    #character_popup {
        width: 100%;
        border-radius: 0 0 20px 20px;
        margin-top: 0px;
        height: calc(100% - var(--topBarBlockSize));
    }

    .drawer25pWidth {
        flex-basis: max(calc(100% / 4 - 10px), 190px);
    }

    .drawer33pWidth {
        flex-basis: max(calc(100% / 3 - 10px), 190px);
    }

    .expression-holder {
        display: none;
    }

    body.waifuMode #sheld {
        height: 40vh;
        height: 40dvh;
        top: 60vh;
        top: 60dvh;
        bottom: 0 !important;
    }

    body:not(.waifuMode) #expression-wrapper {
        visibility: hidden;
    }

    #visual-novel-wrapper {
        position: unset !important;
    }

    body.waifuMode .expression-holder {
        /*display: inline;*/

        max-width: 100vw;
        height: 100vh;
        width: max-content;
        margin: 0 auto;
        position: absolute;
        left: 0;
        right: 0;
        filter: drop-shadow(2px 2px 2px #51515199);
        z-index: 1 !important;
    }

    body.waifuMode img.expression {
        object-fit: cover;
    }

    body.waifuMode .zoomed_avatar_container {
        height: 100%;
    }

    body.waifuMode .zoomed_avatar {
        width: fit-content;
        max-height: calc(60vh - 60px);
        max-height: calc(60dvh - 60px);
        max-width: 90vw;
        max-width: 90dvw;
    }

    .scrollableInner {
        overflow-y: auto;
        overflow-x: hidden;
        max-height: calc(100vh - 90px);
        max-height: calc(100dvh - 90px);
    }

    .horde_multiple_hint {
        display: none;
    }

    /* Lorebook picker dropdown: full-width on mobile to match connection-profile
       model selectors. The trigger is narrow (shared flex row with buttons) so
       Select2 would normally size the dropdown to match. CSS !important beats
       Select2's JS .css() calls, so this wins regardless of repositioning.
       position:fixed is viewport-relative — no document scroll is triggered.
       left:0 + right:0 + width:auto is more robust than width:100dvw because it
       lets the browser fill edge-to-edge without viewport unit rounding errors or
       transform-containing-block side effects from the popup open animation. */
    .select2-dropdown.wi-lorebook-dropdown {
        position: fixed !important;
        left: 0 !important;
        right: 0 !important;
        width: auto !important;
        max-width: none !important;
    }

}


/*landscape mode phones and ipads*/
@media screen and (max-width: 1000px) and (orientation: landscape) {
    body.waifuMode img.expression {
        object-fit: contain;
    }

    .tag.excluded:after {
        top: unset;
        bottom: unset;
    }

    body:not(.waifuMode) .zoomed_avatar {
        max-height: calc(60vh - 60px);
        max-height: calc(60dvh - 60px);
        max-width: 90vw;
        max-width: 90dvw;
        left: 50%;
        top: 50%;
        transform: translateX(-50%) translateY(-50%);
        align-items: center;
        justify-content: center;
        height: fit-content;
        width: 100%;
    }
}

/*portrait mode phones*/
@media screen and (max-width: 450px) {

    body:not(.waifuMode) .zoomed_avatar {
        min-width: 100px;
        min-height: 100px;
        max-height: 50vh;
        max-width: 90vw;
        position: absolute;
        padding: 0;
        filter: drop-shadow(2px 2px 2px #51515199);
        z-index: 30;
        overflow: hidden;
        display: none;
        right: 0;
        left: 50%;
        top: 50%;
        transform: translateX(-50%) translateY(-50%);
        align-items: center;
        justify-content: center;
        height: fit-content;
        width: 100%;
    }

    .drawer25pWidth {
        flex-basis: max(calc(100% / 2 - 10px), 180px);
    }

    .drawer33pWidth {
        flex-basis: max(calc(100% / 2 - 10px), 180px);
    }

    .tag.excluded:after {
        top: unset;
        bottom: unset;
    }


    #leftSendForm,
    #rightSendForm {
        width: 1.15em;
        flex-wrap: wrap;
        height: unset;
    }
}

/*iOS specific*/
@supports (-webkit-touch-callout: none) {
    body {
        margin: 0 auto;
    }

    #top-settings-holder {
        padding-left: max(env(safe-area-inset-left), 8px);
        padding-right: max(env(safe-area-inset-right), 8px);
        touch-action: auto !important;
        -ms-touch-action: auto !important;
        overscroll-behavior-x: contain;
    }

    #top-bar {
        width: 100vw;
        width: 100dvw;
    }

    #sheld {
        margin: unset;
        padding: unset;
        width: unset;
        height: unset;
        min-width: unset;
        max-width: unset;
        min-height: unset;
        max-height: unset;
        width: 100vw;
        width: 100dvw;
        height: calc(100vh - 36px);
        height: calc(100dvh - 36px);
        padding-right: max(env(safe-area-inset-right), 0px);
        padding-left: max(env(safe-area-inset-left), 0px);
        padding-bottom: 0;
    }

    body.PWA #sheld {
        padding-right: max(env(safe-area-inset-right), 2px);
        padding-left: max(env(safe-area-inset-left), 2px);
        padding-bottom: max(env(safe-area-inset-bottom), 15px);

    }

    #character_popup,
    #world_popup,
    #left-nav-panel,
    #right-nav-panel,
    .drawer-content {
        width: unset;
        height: unset;
        min-width: unset;
        max-width: unset;
        min-height: unset;
        max-height: unset;
        backdrop-filter: blur(calc(var(--SmartThemeBlurStrength) * 2));
        left: 0;
        right: 0;
        top: var(--topBarBlockSize);
        margin: 0 auto;
        height: calc(100vh - 70px);
        height: calc(100dvh - 70px);
        width: calc(100dvw - 5px);
        max-height: calc(100vh - 70px);
        max-height: calc(100dvh - 70px);
        max-width: calc(100dvw - 5px);
        /* Safari fix: ensure panels stay above everything and aren't clipped */
        z-index: 9999 !important;
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
        background-color: var(--SmartThemeBlurTintColor);
    }

    #character_popup,
    #world_popup,
    .drawer-content {
        margin-top: 0;
    }

    #PersonaManagement.openDrawer {
        height: calc(100vh - var(--topBarBlockSize) - var(--bottomFormBlockSize) - 12px);
        height: calc(100dvh - var(--topBarBlockSize) - var(--bottomFormBlockSize) - 12px);
        max-height: calc(100vh - var(--topBarBlockSize) - var(--bottomFormBlockSize) - 12px);
        max-height: calc(100dvh - var(--topBarBlockSize) - var(--bottomFormBlockSize) - 12px);
        padding-bottom: calc(var(--bottomFormBlockSize) + env(safe-area-inset-bottom, 0px) + 16px);
        box-sizing: border-box;
        overflow-y: auto !important;
    }

    .scrollableInner {
        overflow-y: auto;
        overflow-x: hidden;
    }

    #horde_model {
        height: unset;
    }

}
